{
  "title": "Monitoraggio Specie Aliene - Nodo Campo",
  "uid": "alien-pest-iot-01",
  "timezone": "browser",
  "schemaVersion": 38,
  "panels": [
    {
      "id": 1,
      "title": "Catture Specie Aliena (Individui Rilevati)",
      "type": "barchart",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [{ "rawSql": "SELECT time AS \"time\", alien_pest_count AS \"Catture\" FROM sensor_telemetry WHERE $__timeFilter(time) ORDER BY time", "format": "time_series" }]
    },
    {
      "id": 2,
      "title": "Accumulo Gradi Giorno (GDD Cumulativi)",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 0 },
      "targets": [{ "rawSql": "SELECT gdd_cumulative FROM daily_gdd ORDER BY date DESC LIMIT 1", "format": "table" }],
      "fieldConfig": { "defaults": { "min": 0, "max": 700, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 400 }, { "color": "red", "value": 500 }] } } }
    },
    {
      "id": 3,
      "title": "Stato Batteria Nodo (V)",
      "type": "stat",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 0 },
      "targets": [{ "rawSql": "SELECT battery_v FROM sensor_telemetry ORDER BY time DESC LIMIT 1", "format": "table" }]
    },
    {
      "id": 4,
      "title": "Microclima: Temperatura (°C) e Umidità (%)",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 8 },
      "targets": [{ "rawSql": "SELECT time AS \"time\", temperature_c AS \"Temperatura (°C)\", humidity_percent AS \"Umidità (%)\" FROM sensor_telemetry WHERE $__timeFilter(time) ORDER BY time", "format": "time_series" }]
    }
  ]
}
